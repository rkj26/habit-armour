# FastAPI server port (default: 3000)
PORT=3000

# Bind address. Defaults to loopback: the API has no auth layer, so 0.0.0.0
# publishes every endpoint (including config writes) to your local network.
# Set to 0.0.0.0 only if you want the iOS remote-status URL to work.
HOST=127.0.0.1

# Hevy API Integration Key (Acquire from hevy.com/settings?developer)
HEVY_API_KEY=your_hevy_api_key_here

# Gemini AI API Key (Acquire from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Journal Storage Configuration
# Options: "none", "obsidian"
JOURNAL_STORAGE=none

# Local Obsidian Vault Integration
OBSIDIAN_VAULT_PATH=~/Documents/Obsidian
OBSIDIAN_JOURNAL_FOLDER=Journal
