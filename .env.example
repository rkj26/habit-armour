# Express Server Port (default: 3000)
PORT=3000

# Hevy API Integration Key (Acquire from hevy.com/settings?developer)
HEVY_API_KEY=your_hevy_api_key_here

# Gemini AI API Key (Acquire from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Sync Settings
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_URL=your_google_apps_script_web_app_url_here

# Journal Storage Configuration
# Options: "none", "obsidian", "gdoc", "both"
JOURNAL_STORAGE=none

# Local Obsidian Vault Integration
OBSIDIAN_VAULT_PATH=~/Documents/Obsidian
OBSIDIAN_JOURNAL_FOLDER=Journal

# Google Doc Integration (For Appending Journal Entries)
GOOGLE_DOC_ID=your_google_doc_id_here
